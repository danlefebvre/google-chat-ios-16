# Relay environment (copy to .env)
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=replace-with-long-random-topic
NTFY_ACCESS_TOKEN=

PORT=8080
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBSUB_SUBSCRIPTION=

# Optional: comma-separated mute lists
# MUTED_ACCOUNTS=issuer|sub-work
# MUTED_SPACES=issuer|sub-work:spaces/AAA

# Optional quiet hours (24h, local timezone)
# QUIET_HOURS_START=22
# QUIET_HOURS_END=7
# QUIET_HOURS_TZ=America/Los_Angeles
