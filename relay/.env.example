PORT=8080
ADMIN_TOKEN=change-me-admin-token
RELAY_TOKEN_SECRET=change-me-32chars-minimum-secret

# Bark (install the Bark iOS app, copy your device key from the test URL)
BARK_BASE_URL=https://api.day.app
BARK_DEVICE_KEY=your-bark-device-key

DEEP_LINK_SCHEME=googlechatmulti

# Durable account store (JSON). Keep ADMIN_TOKEN server-side only — never ship it in the iOS app.
ACCOUNT_STORE_PATH=data/accounts.json

# Optional: shared secret checked on /pubsub/push (?token= or X-Goog-Channel-Token)
PUBSUB_VERIFY_TOKEN=change-me-pubsub-verify

# Optional until Workspace Events are wired.
# GOOGLE_OAUTH_CLIENT_ID must be the same client that issued the app's refresh
# tokens (the iOS OAuth client / GIDClientID). Leave SECRET empty for iOS clients.
GOOGLE_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/chat-events
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional quiet hours (24h clock)
# QUIET_HOURS_START=22
# QUIET_HOURS_END=7
# QUIET_HOURS_TZ=America/Los_Angeles
